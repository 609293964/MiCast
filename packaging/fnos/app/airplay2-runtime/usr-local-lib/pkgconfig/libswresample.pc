prefix=/ffmpeg_build
exec_prefix=${prefix}
libdir=/ffmpeg_build/lib
includedir=/ffmpeg_build/include

Name: libswresample
Description: FFmpeg audio resampling library
Version: 6.3.102
Requires: 
Requires.private: libavutil >= 60.26.102
Conflicts:
Libs: -L${libdir}  -lswresample 
Libs.private: -lm -latomic
Cflags: -I${includedir}
