#!/bin/sh
set -eu

runtime="${MICAST_AIRPLAY2_RUNTIME:?}"
loader="$runtime/lib/ld-musl-x86_64.so.1"
library_path="$runtime/usr-lib/pulseaudio:$runtime/usr-lib:$runtime/usr-local-lib"
config="${MICAST_DATA_DIR:?}/shairport-sync.conf"
log="${MICAST_DATA_DIR:?}/nqptp.log"
callback="${TRIM_APPDEST:?}/airplay2-runtime/callback.py"
name="${MICAST_AIRPLAY_NAME:-MiCast}"
receiver_id="${MICAST_DEVICE_ID:-main}"
shairport_pid_file="${MICAST_DATA_DIR:?}/shairport-sync.pid"
nqptp_pid_file="${MICAST_DATA_DIR:?}/nqptp.pid"

cat > "$config" <<EOF
general = {
  name = "$name";
  output_backend = "stdout";
  service_type = "airplay2";
  ignore_volume_control = "yes";
  log_verbosity = 0;
  audio_decoded_buffer_desired_length_in_seconds = 1.5;
  audio_backend_buffer_desired_length_in_seconds = 0.35;
  run_this_when_volume_is_set = "${PYTHON_BIN} $callback volume $receiver_id ";
};
sessioncontrol = {
  allow_session_interruption = "yes";
  run_this_before_play_begins = "${PYTHON_BIN} $callback start $receiver_id";
  run_this_after_play_ends = "${PYTHON_BIN} $callback stop $receiver_id";
};
stdout = {
  output_rate = 48000;
  output_format = "S16_LE";
  output_channels = 2;
};
EOF

cleanup() {
  [ -n "${shairport_pid:-}" ] && kill "$shairport_pid" 2>/dev/null || true
  [ -n "${nqptp_pid:-}" ] && kill "$nqptp_pid" 2>/dev/null || true
  rm -f "$shairport_pid_file" "$nqptp_pid_file"
}
trap cleanup EXIT INT TERM

"$loader" --library-path "$library_path" "$runtime/bin/nqptp" >>"$log" 2>&1 &
nqptp_pid=$!
echo "$nqptp_pid" > "$nqptp_pid_file"
sleep 1
if ! kill -0 "$nqptp_pid" 2>/dev/null; then
  echo "NQPTP failed to start; see $log" >&2
  exit 1
fi

"$loader" --library-path "$library_path" "$runtime/bin/shairport-sync" -a "$name" -c "$config" &
shairport_pid=$!
echo "$shairport_pid" > "$shairport_pid_file"
wait "$shairport_pid"
