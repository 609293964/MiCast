#!/bin/bash
set -u

# The uninstall wizard supplies one of three explicit retention policies.
# Unknown/missing values fail safe by retaining only non-sensitive settings.
if [ -n "${TRIM_PKGVAR:-}" ] && [ "$TRIM_PKGVAR" != "/" ] && [ -d "$TRIM_PKGVAR" ]; then
  case "${wizard_data_policy:-keep_config}" in
    keep_all)
      find "$TRIM_PKGVAR" -mindepth 1 -maxdepth 1 \
        ! -name micast.json ! -name access.json ! -name xiaomi-account.json \
        ! -name xiaomi-tokens.enc -exec rm -rf -- {} +
      ;;
    remove_all)
      find "$TRIM_PKGVAR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
      ;;
    *)
      find "$TRIM_PKGVAR" -mindepth 1 -maxdepth 1 \
        ! -name micast.json ! -name access.json -exec rm -rf -- {} +
      ;;
  esac
fi
