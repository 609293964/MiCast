# MiCast environment configuration
# Copy this file to .env and fill in your values

# Web / API server
MICAST_HOST=0.0.0.0
MICAST_PORT=3000
MICAST_STREAM_PORT=8080
# PCM source for development
# Examples:
#   MICAST_PCM_SOURCE=tcp:192.168.0.12:9001
#   MICAST_PCM_SOURCE=mock
#   MICAST_PCM_SOURCE=local:shairport-sync
MICAST_PCM_SOURCE=tcp:192.168.0.12:9001
# Optional: override the address advertised to speakers (default: auto-detect LAN IP)
# MICAST_STREAM_HOST=192.168.0.100

# Audio defaults
MI_AUDIO_FORMAT=mp3
MI_AUDIO_BITRATE=320k
MI_AUDIO_SAMPLE_RATE=48000
MI_AUDIO_AUTO_TRANSCODE=true


# Production Docker only: the Web/API talks to this restricted internal service.
# MICAST_ORCHESTRATOR_URL=http://orchestrator:3100
# MICAST_ORCHESTRATOR_TOKEN=replace-with-a-long-random-token

# Xiaomi account (optional cookie login fallback)
XIAOMI_USER_ID=
XIAOMI_PASS_TOKEN=
MICAST_PCM_SAMPLE_RATE=48000
MICAST_STREAM_BUFFER_SECONDS=0.25
