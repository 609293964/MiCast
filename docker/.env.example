# NAS address that Xiaomi speakers can reach.
MICAST_STREAM_HOST=CHANGE-ME

# Physical LAN interface on the NAS. Check with: ip route
MICAST_LAN_INTERFACE=eth0
MICAST_LAN_SUBNET=CHANGE-ME
MICAST_LAN_GATEWAY=CHANGE-ME

# Reserve this range outside the router DHCP pool. /28 provides up to 14 addresses.
MICAST_RECEIVER_IP_RANGE=CHANGE-ME

# Generate once with: openssl rand -hex 32
MICAST_ORCHESTRATOR_TOKEN=replace-with-a-long-random-token

MI_AUDIO_FORMAT=mp3
MI_AUDIO_BITRATE=320k
MI_AUDIO_SAMPLE_RATE=48000
MI_AUDIO_AUTO_TRANSCODE=true
